# Copie para .env (que não vai para o Git) ou configure na hospedagem.

# Chave do Web3Forms: com ela, o formulário envia direto para o e-mail de contato.
# Crie grátis em https://web3forms.com com o e-mail que vai receber as mensagens.
VITE_WEB3FORMS_KEY=

# Domínio do site, usado no build para canonical, og:url, og:image e sitemap.xml.
SITE_URL=https://www.triarii.com.br
